# The factory repo tracks COORDINATION DATA only. Every tool is its own
# standalone git repo pushed independently - never committed here.
deli_counter/
dispatch/
lasertag/
level_factory/
lot/
lux/
patina/
pixelcoat/
pipeline/
zoo/

# Run artifacts (walkabout / headless gates / screenshot passes)
walkabout_*/
headless_*/
shots_*/
*.zip
_lf_*/
_runs/

# scratch and editor backups -- copies of tracked files, not history
_bridge/
__pycache__/
*.pre_wp
*.pre_wpdefault
_scratch_archive/
*.pre_rules
*.pre_cli
*.pre_stamp
*.pre_endings

# build output and editor backups -- regenerable, not history
*.pre_invoke
*.pre_step

# editor backups from patch_*.py -- copies of tracked files, not history.
# A RULE, not a list: each patch invents its own suffix, so any enumeration
# of them falls behind the next patch that gets written.
*.pre_*

# look_shots output -- regenerated per run, and stale copies are exactly the
# evidence problem item 33 is about.
shots_*/
shots_*.json

# Session scratch: one-off probe output, reports, and the dir used to launder
# stale bridge reads. Regenerable; none of it is history.
_scratch/
never_wired.txt
orphan_report.txt
overhang.json
run_*.log
