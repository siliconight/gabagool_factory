[gd_scene load_steps=3 format=3]

[ext_resource type="PackedScene" path="lot/a/inner.tscn" id="1_inner"]

[sub_resource type="GDScript" id="probe"]
script/source = "extends Node3D

func _ready() -> void:
	var n := get_node_or_null('Inner')
	if n == null:
		print('PROBE RESULT: inner.tscn DID NOT INSTANCE')
	elif n.get_node_or_null('Leaf') == null:
		print('PROBE RESULT: inner instanced, LEAF MISSING -> scene-relative NOT supported')
	else:
		print('PROBE RESULT: OK -> relative ext_resource paths resolve scene-relative')
	get_tree().quit()
"

[node name="Probe" type="Node3D"]
script = SubResource("probe")

[node name="Inner" parent="." instance=ExtResource("1_inner")]
