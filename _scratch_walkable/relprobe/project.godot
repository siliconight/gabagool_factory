; Throwaway probe: does Godot resolve a NON-res:// ext_resource path
; relative to the referencing scene's own directory?
config_version=5

[application]
config/features=PackedStringArray("4.7")
config/name="relative ext_resource probe"
run/main_scene="res://probe.tscn"

[rendering]
renderer/rendering_method="gl_compatibility"
