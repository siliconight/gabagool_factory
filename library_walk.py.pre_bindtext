#!/usr/bin/env python3
r"""Re-walk the twenty registered mission sites with the fixed Lot.

    python library_walk.py                 # all twenty
    python library_walk.py --only ballpark_block museum_row
    python library_walk.py --list          # what would run, and its old verdict
    python library_walk.py --keep          # do not rebuild projects that exist

WHY THIS EXISTS
---------------
Every record in pipeline/registries/mission_registry.json carries
`runtime_walktest: pass` -- nineteen `pass`, one `pass_proofs`, recorded
2026-07-21. Those stamps were produced by the walktest whose anchors sat on
furniture: markers were emitted at their own height, so an objective on a
cashier counter resolved to the counter top, a 1.0 m ledge that bakes as an
isolated island. A run could pass that way because the 2.0 m snap budget
forgave a 1.4 m table.

So the library is not unmeasured. It holds twenty green stamps from an
instrument that was wrong, across twenty site geometries, exactly one of which
(rivers_casino) has been re-checked since. A `pass` from a broken instrument is
worse than no stamp at all, because it is the thing that stops anyone looking.

This bypasses Level Factory entirely -- no Deli Counter generation, no Laser
Tag, no art layer. The library specs reference their buildings by RELATIVE path
(`buildings/stadium_a01.glb`), so a site assembles into a throwaway project
directly. What is being tested is the one claim whose measurement was broken:
can the mission spine be walked.

Layout matches the Phase 4 batch (`_runs/<site>_proj`), so phase4m_status.py
still reads these reports.
"""
import argparse
import json
import os
import shutil
import subprocess
import sys
import time

HERE = os.path.dirname(os.path.abspath(__file__))
#: Where Godot lives. walktest.py reads LOT_GODOT/DC_GODOT and then PATH; this
#: script inherits whatever shell it was started from, and a shell without
#: LOT_GODOT set is how the first run of this "completed" twenty sites in zero
#: seconds each. Checked once, up front, before anything is staged.
GODOT_FALLBACKS = (
    r"C:\Godot\4.7\Godot_v4.7-stable_win64_console.exe",
    r"C:\Godot\Godot_v4.7-stable_win64_console.exe",
)
LOT = os.path.join(HERE, "lot")
RUNS = os.path.join(HERE, "_runs")
REGISTRY = os.path.join(HERE, "pipeline", "registries", "mission_registry.json")

PROJECT_GODOT = """; Auto-generated by library_walk.py -- throwaway project.
config_version=5

[application]
config/name="{name}"
config/features=PackedStringArray("4.7")

[editor_plugins]
enabled=PackedStringArray()
"""


def find_godot(explicit=None):
    import shutil as _sh
    for cand in ([explicit] if explicit else []) + [
            os.environ.get("LOT_GODOT"), os.environ.get("DC_GODOT")] + \
            list(GODOT_FALLBACKS) + ["godot4", "godot"]:
        if not cand:
            continue
        path = cand if os.sep in cand else _sh.which(cand)
        if path and os.path.exists(path):
            return path
    return None


def missions():
    """(site_name, scene_stem, spec_abs_path, mission_id, recorded_verdict).

    The folder names the site; the SPEC names the scene. Those are usually the
    same string and for ref_pvp they are not -- the spec calls itself
    `ref_pvp_site`, so Lot writes ref_pvp_site_navqa.tscn while this script
    asked for ref_pvp_navqa.tscn and reported NO REPORT. Read the name Lot will
    actually use rather than the one the directory implies."""
    recs = json.load(open(REGISTRY, encoding="utf-8"))["records"]
    out = []
    for r in sorted(recs, key=lambda x: x["mission_id"]):
        spec = os.path.join(HERE, r["lot_spec_path"].replace("/", os.sep))
        name = os.path.basename(os.path.dirname(spec))
        stem = name
        try:
            stem = json.load(open(spec, encoding="utf-8"))["name"]
        except (OSError, json.JSONDecodeError, KeyError):
            pass
        out.append((name, stem, spec, r["mission_id"],
                    str(r.get("runtime_walktest"))))
    return out


def stage(name, spec, keep=False):
    """A project directory holding the assembled site and its buildings."""
    proj = os.path.join(RUNS, f"{name}_proj")
    if keep and os.path.isdir(proj):
        return proj, "kept"
    if os.path.isdir(proj):
        shutil.rmtree(proj, ignore_errors=True)
    os.makedirs(proj, exist_ok=True)
    with open(os.path.join(proj, "project.godot"), "w", encoding="utf-8") as f:
        f.write(PROJECT_GODOT.format(name=name))
    # The scene instances its buildings as res://buildings/<x>.glb, so they have
    # to sit beside it. Everything else the runner syncs itself.
    src_b = os.path.join(os.path.dirname(spec), "buildings")
    if os.path.isdir(src_b):
        shutil.copytree(src_b, os.path.join(proj, "buildings"))
    setup_src = os.path.join(LOT, "godot", "addons", "lot", "lot_navqa_setup.gd")
    setup_dst = os.path.join(proj, "addons", "lot", "lot_navqa_setup.gd")
    os.makedirs(os.path.dirname(setup_dst), exist_ok=True)
    shutil.copy2(setup_src, setup_dst)
    return proj, "staged"


def assemble(spec, proj):
    r = subprocess.run([sys.executable, os.path.join(LOT, "lot.py"), spec, proj,
                        "--navqa"], capture_output=True, text=True, cwd=LOT)
    return r.returncode, (r.stdout or "") + (r.stderr or "")


def walk(proj, scene, timeout, godot):
    env = dict(os.environ)
    env["LOT_GODOT"] = godot
    # --timeout goes to BOTH: the inner one is what actually kills Godot, and
    # for a long time only the outer one existed, so raising the sweep's timeout
    # left the real 300 s bound untouched and long sites reported NO REPORT.
    # The outer bound is given slack so the inner one reports a clean TIMEOUT
    # rather than being cut off mid-write.
    r = subprocess.run([sys.executable, os.path.join(LOT, "walktest.py"), proj,
                        scene, "--require", "--report-dir", proj,
                        "--timeout", str(timeout)],
                       capture_output=True, text=True, cwd=LOT,
                       timeout=timeout + 120, env=env)
    return r.returncode, (r.stdout or "") + (r.stderr or "")


def read(proj, name):
    p = os.path.join(proj, f"{name}_navqa.walktest.json")
    if not os.path.exists(p):
        return None
    try:
        return json.load(open(p, encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return {"ok": False, "error": "report unreadable"}


def summarise(d):
    if d is None:
        return dict(ok="NO REPORT", anchors=0, stranded=0, no_floor=0,
                    barrier=0, legs=0, failed=0, stuck=0, note="")
    anchors = d.get("anchors") or []
    legs = d.get("path_proofs") or []
    walkers = d.get("walkers") or []
    return dict(
        ok=bool(d.get("ok")),
        anchors=len(anchors),
        stranded=sum(1 for a in anchors if isinstance(a, dict)
                     and a.get("cluster_size", 1) < a.get("main_cluster_size", 1)),
        no_floor=sum(1 for a in anchors if isinstance(a, dict)
                     and a.get("no_standing_room")),
        barrier=sum(1 for a in anchors if isinstance(a, dict)
                    and float(a.get("unreachable_stand_m") or 0) > 0),
        legs=len(legs),
        failed=sum(1 for l in legs if isinstance(l, dict) and not l.get("ok")),
        stuck=sum(1 for w in walkers if isinstance(w, dict)
                  and not str(w.get("status", "")).startswith("ok")),
        note=str(d.get("error") or ""),
    )


#: Severities the emitters actually use. Not a classification -- only an ordering,
#: so the report can rank and the verdict can eventually threshold. A severity not
#: listed here is surfaced as-is rather than assumed harmless.
SEVERITY_RANK = {"major": 3, "moderate": 2, "minor": 1, "info": 0}

#: What BLOCKS. `major` only, and that is a deliberate calibration rather than a
#: default: at moderate-and-above the same sweep listed ~35 findings across
#: nineteen of twenty sites, because LOT_GROUND_EXTENDED and LOT_ROUTE_EXPOSED are
#: moderate on almost every site. Both are correct as designer advice --
#: site_extent.py:359 rates the first moderate precisely because the geometry was
#: fixed while the SPEC stays wrong -- and neither means the level is broken.
#:
#: Severity here answers "how much should a designer care". Whether a build should
#: fail is a different axis, and no threshold on the first can stand in for the
#: second. At `major` the same run produced exactly ONE finding in twenty sites,
#: and every major code is "this level does not work": an objective nothing can
#: path to, an objective on furniture, an unplaceable spawn, a spawn with no
#: cover, a building you walk through.
#:
#: A gate that fails nineteen of twenty sites gets switched off by the first
#: person trying to ship, and is then worse than no gate.
BLOCKING_RANK = 3


def gate_findings(proj, stem):
    """Every finding the build recorded, from the contract it already writes.

    lot.py puts tactical_report into `merged` and serialises it to
    <site>.site.gameplay.json, so each finding is on disk with the severity the
    code that raised it assigned. Reading that field is the whole job.

    This replaced a parser over the build's stdout plus a hardcoded severity
    table. That table's first contact with a real sweep produced 8 unclassified
    codes and, worse, did not contain `moderate` -- a level site_cover.py uses --
    so any guess at those codes was wrong in both directions. A second opinion
    about a value the source already holds is drift with a schedule.

    Returns [(code, severity, message)]; [] when the contract is unreadable, which
    the caller reports as unchecked rather than clean.
    """
    path = os.path.join(proj, f"{stem}.site.gameplay.json")
    try:
        with open(path, "r", encoding="utf-8") as f:
            gp = json.load(f)
    except (OSError, ValueError):
        return None                        # distinct from "no findings"
    found = ((gp.get("tactical") or {}).get("findings")) or []
    out = []
    for f_ in found:
        if not isinstance(f_, dict):
            continue
        out.append((str(f_.get("code") or "UNCODED"),
                    str(f_.get("severity") or "unspecified"),
                    str(f_.get("message") or "")))
    return out


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("--only", nargs="*", default=None,
                    help="site names (the spec's folder), default all twenty")
    ap.add_argument("--list", action="store_true")
    ap.add_argument("--keep", action="store_true",
                    help="reuse an existing project dir instead of rebuilding")
    ap.add_argument("--timeout", type=int, default=1200)
    ap.add_argument("--godot", default=None,
                    help="path to the Godot binary; default LOT_GODOT, then "
                         "DC_GODOT, then the usual install locations, then PATH")
    args = ap.parse_args()

    todo = missions()
    if args.only:
        want = set(args.only)
        todo = [m for m in todo if m[0] in want]
        missing = want - {m[0] for m in todo}
        if missing:
            print(f"no such site(s): {', '.join(sorted(missing))}")
            return 2

    if args.list:
        print(f"{'site':<22} {'scene stem':<22} {'mission':<28} "
              f"{'recorded':<12} spec exists")
        for name, stem, spec, mid, was in todo:
            print(f"{name:<22} {stem:<22} {mid:<28} {was:<12} "
                  f"{os.path.exists(spec)}")
        print(f"\n{len(todo)} site(s)")
        return 0

    godot = find_godot(args.godot)
    if not godot:
        print("Godot not found. Twenty sites would each 'complete' in zero "
              "seconds with no report, which is what happened the first time "
              "this ran. Set LOT_GODOT or pass --godot <path>.")
        return 2
    print(f"godot: {godot}")

    os.makedirs(RUNS, exist_ok=True)
    results = []
    t_all = time.time()
    for i, (name, stem, spec, mid, was) in enumerate(todo, 1):
        print(f"\n=========== [{i}/{len(todo)}] {name} "
              f"(recorded: {was}) ===========", flush=True)
        if not os.path.exists(spec):
            print(f"  spec missing: {spec}")
            results.append((name, mid, was, dict(
                ok="SPEC MISSING", anchors=0, stranded=0, no_floor=0, barrier=0,
                legs=0, failed=0, stuck=0, note=spec)))
            continue
        t0 = time.time()
        proj, how = stage(name, spec, keep=args.keep)
        rc, out = assemble(spec, proj)
        if rc != 0:
            tail = "; ".join(l for l in out.splitlines() if l.strip())[-300:]
            print(f"  ASSEMBLE FAILED ({how}): {tail}")
            results.append((name, mid, was, dict(
                ok="ASSEMBLE FAILED", anchors=0, stranded=0, no_floor=0,
                barrier=0, legs=0, failed=0, stuck=0, note=tail)))
            continue
        for line in out.splitlines():
            if line.startswith("[lot]"):
                print("  " + line)
        try:
            rc, out = walk(proj, f"{stem}_navqa.tscn", args.timeout, godot)
        except subprocess.TimeoutExpired:
            print(f"  WALKTEST TIMED OUT after {args.timeout}s")
            results.append((name, mid, was, dict(
                ok="TIMEOUT", anchors=0, stranded=0, no_floor=0, barrier=0,
                legs=0, failed=0, stuck=0, note=f"{args.timeout}s")))
            continue
        # A filter that only matches interesting SUCCESS lines turns a failure
        # into an empty block, and an empty block reads as nothing happening.
        # The first run of this script "finished" a site in 0 s with no output
        # because Godot was never found -- the same shape as every defect this
        # pass has been about. On a non-zero return, print everything.
        if rc != 0:
            print(f"  WALKTEST EXITED {rc}:")
            for line in out.splitlines()[-25:]:
                if line.strip():
                    print("    " + line.rstrip())
        else:
            for line in out.splitlines():
                if "[nav-qa]" in line and ("OFF THE MAIN" in line or "STUCK" in line
                                           or "NO STANDING ROOM" in line
                                           or "barrier" in line):
                    print("  " + line.strip())
        s = summarise(read(proj, stem))
        s["rc"] = rc
        # Read AFTER the build, from the contract the build wrote. None means the
        # contract could not be read at all, which is not the same as a clean
        # site and is reported separately below.
        s["gates"] = gate_findings(proj, stem)
        results.append((name, mid, was, s))
        print(f"  -> ok={s['ok']}  legs {s['legs'] - s['failed']}/{s['legs']}  "
              f"stranded={s['stranded']}  no_floor={s['no_floor']}  "
              f"barrier={s['barrier']}  stuck_walkers={s['stuck']}  "
              f"[{time.time() - t0:.0f}s]", flush=True)

    print("\n" + "=" * 104)
    print(f"{'site':<22} {'was':<12} {'now':<14} {'anchors':>7} {'strand':>6} "
          f"{'nofloor':>7} {'barrier':>7} {'legs':>9} {'stuck':>5} {'gates':>7}")
    print("-" * 112)
    regressions, clean = [], []
    for name, mid, was, s in results:
        legs = f"{s['legs'] - s['failed']}/{s['legs']}"
        _g = s.get("gates")
        _major = ("?" if _g is None else
                  sum(1 for _c, _sev, _m in _g
                      if SEVERITY_RANK.get(_sev, BLOCKING_RANK) >= BLOCKING_RANK))
        # The walkers finishing is necessary and not sufficient. `now` carries
        # the walktest's own verdicts -- TIMEOUT, NO REPORT, ASSEMBLE FAILED --
        # and those all mean the measurement did not complete. `blocked` means it
        # DID complete and the level is broken anyway, which is a different fact
        # and the reason the gates column was worth adding. A `?` means the
        # contract could not be read: neither clean nor blocked, and not passed,
        # because a check that did not run must not report what a clean run
        # reports.
        _walked = s["ok"] is True
        if not _walked:
            now = str(s["ok"])
        elif _major == "?":
            now = "unchecked"
        elif _major:
            now = "blocked"
        else:
            now = "pass"
        print(f"{name:<22} {was:<12} {now:<14} {s['anchors']:>7} "
              f"{s['stranded']:>6} {s['no_floor']:>7} {s['barrier']:>7} "
              f"{legs:>9} {s['stuck']:>5} {(_major or ''):>7}")
        (clean if now == "pass" else regressions).append(name)
    print("-" * 104)
    print(f"{len(clean)} of {len(results)} come back ok; "
          f"{time.time() - t_all:.0f}s total")
    _blocked_sites = [n for n, _m, _w, s in results
                      if s["ok"] is True and s.get("gates")
                      and any(SEVERITY_RANK.get(sev, BLOCKING_RANK)
                              >= BLOCKING_RANK for _c, sev, _m2 in s["gates"])]
    if _blocked_sites:
        print(f"{len(_blocked_sites)} walked clean and are BLOCKED by a gate: "
              f"{', '.join(_blocked_sites)}")
        print("  The walkers finished. The level is broken anyway -- see the "
              "major list below.")

    # What the gates found, REPORTING ONLY -- no verdict above depends on it yet.
    # This is the list to read before making them binding: every site here either
    # has a real defect or a gate that is wrong about it, and which one has to be
    # established per site. See GUARDRAILS_PLAN.md, phase 1.
    _blocking, _advice, _unclassified, _minor = [], [], [], 0
    for name, _mid, _was, s in results:
        _g = s.get("gates")
        if _g is None:
            # The contract could not be read. Not clean -- unchecked.
            _unclassified.append((name, "CONTRACT UNREADABLE",
                                  "no <site>.site.gameplay.json to read "
                                  "findings from"))
            continue
        for code, sev, msg in _g:
            rank = SEVERITY_RANK.get(sev)
            if rank is None:
                _unclassified.append((name, code, f"severity {sev!r}: {msg}"))
            elif rank >= BLOCKING_RANK:
                _blocking.append((name, code, msg))
            elif rank == 2:
                # Advice, not a blocker. Listed on its own rather than hidden:
                # a finding nobody sees is a finding nobody fixes, and folding
                # these into the minor count would trade one wrong threshold for
                # a quieter one.
                _advice.append((name, code, msg))
            else:
                _minor += 1
    print()
    if _blocking:
        print(f"{len(_blocking)} MAJOR gate finding(s) on "
              f"{len({n for n, _c, _m in _blocking})} site(s). These do NOT "
              f"affect the verdict above yet:")
        for name, code, msg in _blocking:
            print(f"  {name:<22} {code}")
            print(f"  {'':<22}   {msg[:150]}")
    else:
        print("No major gate findings.")
    if _advice:
        _sites = len({n for n, _c, _m in _advice})
        print(f"\n{len(_advice)} moderate finding(s) on {_sites} site(s) -- "
              f"designer advice, NOT blockers.\nThe level works; the spec or the "
              f"tactical layout wants attention:")
        _by_code = {}
        for name, code, _m in _advice:
            _by_code.setdefault(code, []).append(name)
        for code, names in sorted(_by_code.items()):
            _shown = ", ".join(sorted(names)[:6])
            _more = f" +{len(names) - 6} more" if len(names) > 6 else ""
            print(f"  {code:<32}{len(names):>3} site(s): {_shown}{_more}")
    if _unclassified:
        print(f"\n{len(_unclassified)} finding(s) this script could not rank, "
              f"or sites whose contract\ncould not be read. Neither is clean, "
              f"and neither may pass for it:")
        for name, code, msg in _unclassified:
            print(f"  {name:<22} {code}")
    print(f"\n{_minor} minor/info finding(s) not listed. Severity comes from "
          f"the emitter that\nraised each finding, not from this script. Only "
          f"`major` counts in the gates\ncolumn and only `major` will block "
          f"when the verdict starts depending on it;\nmoderate is grouped above "
          f"as advice, minor and info are counted here, and `?`\nmeans the "
          f"contract could not be read at all.")
    if regressions:
        # These are the ones that carried a `pass` stamp and do not earn one
        # from an instrument that measures what the stamp claimed.
        print(f"\nnot ok: {', '.join(regressions)}")
        print("Read _runs/<site>_proj/<site>_navqa.walktest.json for the detail: "
              "`anchors` says which are stranded or behind a barrier, "
              "`path_proofs` says which leg, `walkers` says what a body hit.")
    # Non-zero when anything did not come back clean, INCLUDING a site the
    # walkers completed that a gate blocks. Before this, a blocked site exited 0
    # and every wrapper read that as success.
    return 0 if not regressions else 1


if __name__ == "__main__":
    raise SystemExit(main())
